---
/* Kontakt — údaje + formulár (fetch JSON → /api/kontakt.php, časový token z /api/token.php).
   defaultTyp: voliteľné predvolenie selectu typ_projektu (LP stránky). */
import { SITE, PROJECT_TYPES } from '../data/site';
interface Props { defaultTyp?: string }
const { defaultTyp } = Astro.props;
---
<section class="d1-section d1-contact" id="kontakt">
  <div class="d1-eyebrow"><span class="d1-eyebrow-title">Napíšte nám</span></div>
  <div class="d1-contact-grid">
    <div>
      <p class="d1-contact-lead">V akom <em>priestore</em> ste?</p>
      <p class="d1-contact-body">
        Napíšte v jednej-dvoch vetách, kde sa práve nachádzate v projekte — či len uvažujete, máte pôdorys, alebo už staviate. Ozveme sa Vám.
      </p>
      <dl class="d1-contact-meta">
        <div><dt class="au-label">Email</dt><dd><a class="ulink" href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
        <div><dt class="au-label">Telefón</dt><dd><a class="ulink" href={SITE.phoneHref}>{SITE.phone}</a></dd></div>
        <div><dt class="au-label">Instagram</dt><dd><a class="ulink" href={SITE.instagram} target="_blank" rel="noreferrer">{SITE.instagramHandle}</a></dd></div>
        <div><dt class="au-label">Adresa</dt><dd>{SITE.city} · {SITE.country}</dd></div>
      </dl>
    </div>

    <div>
      <form class="au-contact-form" data-au-form method="POST">
        <div class="au-field">
          <label for="k-meno">Meno *</label>
          <input id="k-meno" name="meno" type="text" required autocomplete="name" placeholder="Vaše meno" />
        </div>
        <div class="au-field">
          <label for="k-email">E-mail *</label>
          <input id="k-email" name="email" type="email" required autocomplete="email" placeholder="vy@example.sk" />
        </div>
        <div class="au-field">
          <label for="k-tel">Telefón *</label>
          <input id="k-tel" name="telefon" type="tel" required autocomplete="tel" placeholder="+421" />
        </div>
        <div class="au-field">
          <label for="k-typ">Typ projektu</label>
          <select id="k-typ" name="typ_projektu">
            <option value="" disabled selected={!defaultTyp}>— vyberte —</option>
            {PROJECT_TYPES.map((t) => <option selected={t === defaultTyp}>{t}</option>)}
          </select>
        </div>
        <div class="au-field">
          <label for="k-sprava">Kde ste v projekte *</label>
          <textarea id="k-sprava" name="sprava" required placeholder="Ešte uvažujem · Mám pôdorys · Pripravujem stavbu · Realizujeme"></textarea>
        </div>

        <!-- honeypot -->
        <div class="au-hp" aria-hidden="true">
          <label for="k-hp">Nevypĺňať</label>
          <input id="k-hp" name="_hp" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <button type="submit" class="au-cta">Odoslať <span class="arr">→</span></button>
        <p class="au-form-status" data-au-status role="status" aria-live="polite"></p>
        <p class="au-form-note">
          Odoslaním formulára spracúvame vaše údaje za účelom odpovede na dopyt. Viac v
          <a href="/ochrana-osobnych-udajov/">zásadách ochrany osobných údajov</a>.
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector('[data-au-form]');
  const status = document.querySelector('[data-au-status]');
  // endpoint len v JS (nie v action), nech ho boty čítajúce HTML nenájdu
  const ENDPOINT = '/api/kontakt.php';

  // Časový token proti botom: vypýta sa pri prvom kliknutí do formulára, kontakt.php
  // overí podpis a odstup aspoň 3 s. Keď token nepríde (sieť), formulár sa odošle aj tak
  // — server chýbajúci token len označí, lead nezahodí.
  const TOKEN_MIN_AGE_MS = 3200;
  let tokenReq: Promise<{ t?: number; s?: string; at: number }> | null = null;
  function getToken() {
    if (!tokenReq) {
      tokenReq = Promise.race([
        fetch('/api/token.php', { headers: { Accept: 'application/json' }, cache: 'no-store' }).then((r) => r.json()),
        new Promise((_, reject) => setTimeout(() => reject(new Error('timeout')), 4000)),
      ])
        .then((tok: any) => ({ t: tok.t, s: tok.s, at: Date.now() }))
        .catch(() => ({ at: Date.now() }));
    }
    return tokenReq;
  }
  form?.addEventListener('focusin', getToken, { once: true });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!(form instanceof HTMLFormElement) || !status) return;
    const hp = form.querySelector('input[name="_hp"]');
    if (hp instanceof HTMLInputElement && hp.value.trim() !== '') return; // bot
    if (!form.checkValidity()) { form.reportValidity(); return; }

    status.textContent = 'Odosielam…';
    status.removeAttribute('data-state');
    try {
      const tok = await getToken();
      // token mladší ako 3 s (napr. formulár obnovený prehliadačom a hneď odoslaný) → počkaj zvyšok
      const wait = tok.t ? TOKEN_MIN_AGE_MS - (Date.now() - tok.at) : 0;
      if (wait > 0) await new Promise((r) => setTimeout(r, wait));
      const payload = Object.assign(Object.fromEntries(new FormData(form).entries()), tok.t ? { _t: tok.t, _s: tok.s } : {});
      const res = await fetch(ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success) {
        form.reset();
        // status hlášku nahrádza ďakovná stránka. Redirect až keď GA4 + GTM potvrdia
        // form_submit (inak sa hit pri rýchlej navigácii stratí, hlavne na mobile),
        // najskôr však po 500 ms: GTM hlási Custom HTML tag (Meta fbq) hotový hneď po
        // spustení, nie po odoslaní hitu — bez minima by sa Lead mohol odrezať.
        // Poistka 800 ms presmeruje vždy — aj bez súhlasu či pri zablokovanom gtag.js.
        const t0 = Date.now();
        let left = false;
        const go = () => { if (left) return; left = true; window.location.href = '/dakujeme/'; };
        const goAfterMin = () => setTimeout(go, Math.max(0, 500 - (Date.now() - t0)));
        setTimeout(go, 800);
        // príznak pre záložný generate_lead na /dakujeme/ (AnalyticsEvents ho spotrebuje 1×)
        try { sessionStorage.setItem('au_form_ok', '1'); } catch {}
        // konverzný event LEN pri úspechu (nie pri chybe)
        try {
          if (window.auTrack) window.auTrack('form_submit', { form_id: 'kontakt' }, { beacon: true, callback: goAfterMin, timeout: 800 });
          else goAfterMin();
        } catch { goAfterMin(); }
      } else {
        status.setAttribute('data-state', 'err');
        status.textContent = data.message || 'Správu sa nepodarilo odoslať. Napíšte nám prosím priamo na info@auresa.sk.';
      }
    } catch {
      status.setAttribute('data-state', 'err');
      status.textContent = 'Správu sa nepodarilo odoslať. Napíšte nám prosím priamo na info@auresa.sk.';
    }
  });
</script>
