    <string name="picker_note">Hodnoty pochádzajú z manuálov výrobcov. Položky označené „orientačné“ sa nepodarilo overiť priamo v manuáli – pred nastavovaním ich porovnaj s manuálom k tvojmu motocyklu. Otáčkomer meria jednovalcové motory.</string>

    <!-- info -->
    <string name="info_idle_model">Sýte zelené pásmo %1$s ot./min je predpísaný voľnobeh pre %2$s.</string>
    <string name="info_idle_custom">Sýte zelené pásmo %1$s ot./min je voľnobeh, ktorý si zadal pri vlastnom motocykli.</string>
    <string name="info_idle_unknown">Manuál pre %1$s číselný voľnobeh neuvádza. Nastav čo najnižší voľnobeh, pri ktorom motor beží stabilne a nezhasína.</string>
    <string name="info_idle_single">Manuál uvádza jedno číslo bez tolerancie, preto aplikácia berie ako „v pásme“ aj ±%1$d ot./min – to je presnosť merania, nie údaj výrobcu.</string>
    <string name="info_run_in">Červená čiara na %1$s ot./min je strop zábehu podľa manuálu.</string>
    <string name="info_work_band">Svetlé pásmo je tvoj pracovný rozsah. Výrobcovia ho väčšinou neuvádzajú, takže predvolených 3 500 – 7 000 je len východisko – prestav si ho podľa toho, ako motorku reálne jazdíš.</string>
    <string name="info_placement">Telefón drž asi pol metra od koncovky výfuku, nie priamo v prúde plynov. Meranie je najpresnejšie na ustálených otáčkach.</string>
    <string name="info_freeze">Ak zhoda signálu klesne pod 40 % alebo je zvuk príliš slabý, číslo sa zamrazí – vtedy je okolo priveľa hluku alebo je motorka ďaleko.</string>
    <string name="info_source">Zdroj údajov: %1$s.</string>
    <string name="info_source_unverified">Orientačná hodnota, neoverená priamo v manuáli (zdroj: %1$s). Pred nastavovaním ju porovnaj s manuálom.</string>

